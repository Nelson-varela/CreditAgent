# Copy to .env (never commit .env). Any value here overrides the default in config.py.

# --- AWS ---
AWS_PROFILE=credit-agent
AWS_REGION=us-east-2

# --- Langfuse (cloud free tier) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Reference date for every age-based rule (never "today") ---
AS_OF_DATE=2026-06-30
